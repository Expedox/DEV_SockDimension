config_version=5

[application]

config/name="Sock Dimension"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Config="*res://scripts/autoload/config.gd"
Events="*res://scripts/autoload/events.gd"
GameState="*res://scripts/autoload/game_state.gd"
Settings="*res://scripts/autoload/settings.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
Achievements="*res://scripts/achievements/achievement_service.gd"
Sfx="*res://scripts/autoload/sfx.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"

[internationalization]

locale/translations=PackedStringArray("res://i18n/game_text.en.translation")
locale/fallback="en"

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="socks"
3d_physics/layer_3="player"
3d_physics/layer_4="floor_socks"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4
jolt_physics_3d/limits/max_bodies=20000
jolt_physics_3d/limits/max_body_pairs=262144
jolt_physics_3d/limits/max_contact_constraints=131072
jolt_physics_3d/limits/temporary_memory_buffer_size=256
